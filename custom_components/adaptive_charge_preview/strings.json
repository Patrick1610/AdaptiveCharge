  "services": {
    "start": {
      "name": "Start charging request",
      "description": "With the master off this only simulates. With the master on, control the selected vehicle toward its target and departure."
    },
    "set_target": {
      "name": "Set target",
      "description": "Change own target/departure without resetting delivered energy. An inactive change does not start charging."
    },
    "stop": {
      "name": "Stop charging request",
      "description": "Revoke resume rights and end only owned grid charging. Green remains the baseline."
    },
    "follow_helpers": {
      "name": "Follow bound helpers",
      "description": "Remove local target/departure overrides and follow bound helpers without starting a new request."
    }
